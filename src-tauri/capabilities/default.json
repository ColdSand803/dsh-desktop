{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability: allow the main window to emit theme events to the Rust host",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "updater:default",
    "dialog:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close"
  ]
}